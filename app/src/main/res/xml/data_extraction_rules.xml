<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
  <cloud-backup>
    <!-- Provider credentials are in this DataStore. Explicit in-app backups remain available. -->
    <exclude domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="sharedpref" path="crash_handler.xml" />
    <!-- Official netdisk logins may leave origin cookies/localStorage in WebView. -->
    <exclude domain="root" path="app_webview/" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="sharedpref" path="crash_handler.xml" />
    <exclude domain="root" path="app_webview/" />
  </device-transfer>
</data-extraction-rules>
